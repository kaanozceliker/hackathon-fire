# OpenAI API anahtarı (yapay zeka olay komutanı için). Bu dosyayı .env olarak kopyalayın.
# Anahtar yalnızca sunucuda kullanılır, tarayıcıya gönderilmez.
OPENAI_API_KEY=
# İsteğe bağlı: kullanılacak model (varsayılan gpt-5.5)
OPENAI_MODEL=gpt-5.5

# MapTiler anahtarı (3B harita, Satellite Hybrid). Tarayıcıda kullanılır: MapTiler Cloud'da izinli alan adlarıyla sınırlayın.
VITE_MAPTILER_KEY=
